	(text "LightBoard rev A.  +5 V ONLY (MIC4801 absolute max 6 V).  ~1.4 A at the default 331 mA per LED."
		(exclude_from_sim no)
		(at 15 262.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f8aa3193-bf5f-583a-914c-3a2892517c2a")
	)
	(text "Per channel: +5V -> LED -> Rdrop 2.7R -> MIC4801 D1 -> GND.  Rdrop takes the headroom the SOIC-8 cannot dissipate."
		(exclude_from_sim no)
		(at 15 267.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "46e5e6d1-072b-5186-a17e-5cff13c25bb9")
	)
	(text "RSET: 15k = 331 mA (default), 10k = 499 mA (bolt to a heatsink), 22k = 225 mA.  Rdrop = 0R for a 1-cell Li-ion supply."
		(exclude_from_sim no)
		(at 15 272.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6165a8e0-a2b7-50ef-b094-f5ca398822c7")
	)
	(text "SW1 ON: EN = +5V via R11.  SW1 EXT: EN = J2 PWM via R12 (200 Hz-10 kHz linear; first pulse >= 60 us wakes the MIC4801)."
		(exclude_from_sim no)
		(at 15 277.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b94c0db1-2526-5457-940f-a4ae5addaded")
	)
