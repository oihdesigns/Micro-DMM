	(text "Isolated_ADS1256 rev A.  Everything right of U1/PS1 is isolated (GNDI).  Host side: GND, +5V, VIO."
		(exclude_from_sim no)
		(at 15 272.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "563d8e28-9e77-5eb7-82e3-329196af11ee")
	)
	(text "COM is the isolated-side reference terminal: a buffered 1.5 V above GNDI, centred in the ADS1256 buffered input range (0..3 V)."
		(exclude_from_sim no)
		(at 15 277.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2693be92-5cfa-5806-b73e-f38dce5ba025")
	)
	(text "Connect the measured circuit to COM (JP1 does this at the shunt I- end).  Do NOT tie GNDI to the measured circuit too."
		(exclude_from_sim no)
		(at 15 282.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8de53e8d-5df0-5f52-9f38-07dc40ddee3b")
	)
	(text "AIN0/AIN1: Vin = Vdiff * 248.5.  Use BUFEN=1, PGA 4 (+/-1.25 V FS = +/-310 V).  Each HV terminal must stay within ~+/-370 V of COM."
		(exclude_from_sim no)
		(at 15 287.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0be87082-818d-533a-9a52-1d8a3ce73219")
	)
	(text "AIN2/AIN3: I = Vdiff / 0.1 Ohm.  PGA 8 = +/-6.25 A FS; RS1 is rated 1.5 W (~3.8 A continuous)."
		(exclude_from_sim no)
		(at 15 292.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d25d327b-b5fb-53db-be04-b4ffa77f6de1")
	)
	(text "D0/CLKOUT drives 7.68 MHz after reset: clear CLK1:0 in the ADCON register if D0 is unused or used as GPIO."
		(exclude_from_sim no)
		(at 15 297.88 0)
		(effects
