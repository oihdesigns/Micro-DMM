(version 1)
(rule "Field voltage nodes" (condition "(A.NetName == '/RAIL_IN' || A.NetName == '/SWITCHED_PRE' || A.NetName == '/RAIL_OUT' || A.NetName == '/SOURCE_FLOAT' || A.NetName == '/GATE_1' || A.NetName == '/GATE_2' || A.NetName == '/MCAP_1' || A.NetName == '/MCAP_2' || A.NetName == '/DIV_1' || A.NetName == '/DIV_2') || (B.NetName == '/RAIL_IN' || B.NetName == '/SWITCHED_PRE' || B.NetName == '/RAIL_OUT' || B.NetName == '/SOURCE_FLOAT' || B.NetName == '/GATE_1' || B.NetName == '/GATE_2' || B.NetName == '/MCAP_1' || B.NetName == '/MCAP_2' || B.NetName == '/DIV_1' || B.NetName == '/DIV_2')") (constraint clearance (min 0.8mm)))
(rule "Low voltage floating gate domain" (condition "(A.NetName == '/SOURCE_FLOAT' || A.NetName == '/GATE_1' || A.NetName == '/GATE_2' || A.NetName == '/MCAP_1' || A.NetName == '/MCAP_2') && (B.NetName == '/SOURCE_FLOAT' || B.NetName == '/GATE_1' || B.NetName == '/GATE_2' || B.NetName == '/MCAP_1' || B.NetName == '/MCAP_2')") (constraint clearance (min 0.3mm)))
(rule "Control to live field copper" (condition "(((A.NetName == '/+3V3' || A.NetName == '/GND_LOGIC' || A.NetName == '/EN' || A.NetName == '/EN_A' || A.NetName == '/EN_B' || A.NetName == '/TT_1' || A.NetName == '/TT_2' || A.NetName == '/VOUT_P' || A.NetName == '/VOUT_N' || A.NetName == '/AMC_LLDO' || A.NetName == '/DIAG_N' || A.NetName == '/I_FILTER' || A.NetName == '/IOUT_ADC') && (B.NetName == '/RAIL_IN' || B.NetName == '/SWITCHED_PRE' || B.NetName == '/RAIL_OUT' || B.NetName == '/SOURCE_FLOAT' || B.NetName == '/GATE_1' || B.NetName == '/GATE_2' || B.NetName == '/MCAP_1' || B.NetName == '/MCAP_2' || B.NetName == '/DIV_1' || B.NetName == '/DIV_2' || B.NetName == '/GND_LOAD_RETURN' || B.NetName == '/AMC_HRAW' || B.NetName == '/AMC_HLDO' || B.NetName == '/SENSE_IN')) || ((B.NetName == '/+3V3' || B.NetName == '/GND_LOGIC' || B.NetName == '/EN' || B.NetName == '/EN_A' || B.NetName == '/EN_B' || B.NetName == '/TT_1' || B.NetName == '/TT_2' || B.NetName == '/VOUT_P' || B.NetName == '/VOUT_N' || B.NetName == '/AMC_LLDO' || B.NetName == '/DIAG_N' || B.NetName == '/I_FILTER' || B.NetName == '/IOUT_ADC') && (A.NetName == '/RAIL_IN' || A.NetName == '/SWITCHED_PRE' || A.NetName == '/RAIL_OUT' || A.NetName == '/SOURCE_FLOAT' || A.NetName == '/GATE_1' || A.NetName == '/GATE_2' || A.NetName == '/MCAP_1' || A.NetName == '/MCAP_2' || A.NetName == '/DIV_1' || A.NetName == '/DIV_2' || A.NetName == '/GND_LOAD_RETURN' || A.NetName == '/AMC_HRAW' || A.NetName == '/AMC_HLDO' || A.NetName == '/SENSE_IN')))") (constraint clearance (min 2.5mm)))
(rule "ACS conductor equipotential terminals" (condition "(A.NetName == '/SWITCHED_PRE' || A.NetName == '/RAIL_OUT') && (B.NetName == '/SWITCHED_PRE' || B.NetName == '/RAIL_OUT')") (constraint clearance (min 0.3mm)))
(rule "Unused pins" (condition "A.NetName == 'unconnected-*' || B.NetName == 'unconnected-*'") (constraint clearance (min 0.25mm)))
