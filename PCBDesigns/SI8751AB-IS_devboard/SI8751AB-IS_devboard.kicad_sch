ize 1.27 1.27)) (justify left top)) (uuid "04d592a1-158d-5fc5-b179-067a1a6c8085"))(symbol (lib_id "Devboard:PWR_FLAG") (at 35.56 172.72 0) (unit 1) (in_bom no) (on_board no) (dnp no) (uuid "b221bc1d-174e-5328-99ca-33ecbc2a45db")
