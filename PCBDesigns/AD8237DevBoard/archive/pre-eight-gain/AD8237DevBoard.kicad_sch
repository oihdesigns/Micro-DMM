	(text "I2C init: reg 0x01=0x00 BEFORE reg 0x03=0xF0.\nThen reg 0x50=0x40 disables port pull-ups.\nGain: reg 0x01 = 0 / 1 / 2 / 3 -> 1 / 10.09 / 101 / 1001.\n4.7k address pull-downs select unity before initialization."
		(exclude_from_sim no)
		(at 241.3 233.68 0)
